# Model credentials stay on the deployment host and must never be committed with a value.
GPT_API_KEY=

# Public Harness origin accepted by the Host/Origin fence.
ONTOLOGY_HARNESS_TRUSTED_HOST=agent.example.com
ONTOLOGY_HARNESS_PORT=3080
ONTOLOGY_PRODUCT_NAME=Ontology Agent
HARNESS_IDENTITY_BUNDLE=ontology

# Production Runtime must use HTTPS. The Harness container must trust its certificate chain.
ONTOLOGY_BASE_URL=https://ontology.example.com
ONTOLOGY_REQUEST_TIMEOUT_MS=15000

# Stage 9 rollback value; Ontology mode does not load the JDCloud Bundle.
JDCLOUD_DEFAULT_BASE_URL=https://mi.kindoucloud.com

TZ=Asia/Hong_Kong
